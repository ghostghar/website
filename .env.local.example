# Goshtghar Environment Variables (.env.local)

# 1. MongoDB Database Connection
# Replace with your actual MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/goshtghar?retryWrites=true&w=majority

# 2. Cloudinary Credentials (For Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 3. Security & Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=goshtghar123
JWT_SECRET=goshtghar-jwt-secret-key-2026
